{
  "name": "reachline",
  "version": "1.0.0",
  "private": true,
  "description": "Layered machine reachability diagnostics without relying on ICMP.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
